# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel (produção).
# Nunca versione arquivos .env com valores reais.

# ── Encaminhamento comercial ─────────────────────────────────────────────
# Landing page da parceria (destino do CTA "Conhecer a parceria OpenGate").
# Embutida no build: após alterar na Vercel, faça um novo deploy.
NEXT_PUBLIC_PARTNER_URL=https://integradores-opengate.framer.website

# Site institucional da OpenGate (logo e rodapé). Embutido no build.
NEXT_PUBLIC_INSTITUTIONAL_URL=https://site-opengate.vercel.app

# ── Inteligência artificial (opcional) ──────────────────────────────────
# Sem chave, o diagnóstico funciona normalmente com a leitura por regras.
# Chave da API da Anthropic (console.anthropic.com). Somente servidor: NUNCA use prefixo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Modelo usado para redigir a leitura (padrão: claude-opus-5-5).
AI_MODEL=claude-opus-5-5
# "false" desliga a IA mesmo com a chave configurada.
AI_ENABLED=true

# ── Proteção do endpoint ────────────────────────────────────────────────
# Requisições por IP a cada 10 minutos, por instância (padrão: 12).
RATE_LIMIT_MAX=12

# ── Mensuração (opcional) ───────────────────────────────────────────────
# ID do Meta Pixel. Vazio = Pixel não é carregado. Embutido no build.
NEXT_PUBLIC_META_PIXEL_ID=
