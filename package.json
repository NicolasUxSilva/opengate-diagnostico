{
  "name": "opengate-diagnostico",
  "version": "1.0.0",
  "private": true,
  "description": "Diagnóstico de Operação OpenGate — experiência interativa de qualificação para integradores de segurança eletrônica",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
